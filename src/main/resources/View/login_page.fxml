<AnchorPane prefHeight="572.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controllers.Login.LoginPageController">
   <children>
    <Button fx:id="btnLogin" layoutX="231.0" layoutY="433.0" mnemonicParsing="false" onAction="#btnLoginOnAction" prefHeight="40.0" prefWidth="137.0" text="Login" textFill="#1800b4">
         <font>
            <Font name="System Bold" size="19.0" />
         </font>
      </Button>
      <PasswordField fx:id="txtPassword" layoutX="224.0" layoutY="373.0" prefHeight="26.0" prefWidth="272.0" promptText="Enter password" />
      <Label layoutX="134.0" layoutY="366.0" prefHeight="40.0" prefWidth="60.0" text="Password" />
      <Label layoutX="134.0" layoutY="311.0" prefHeight="40.0" prefWidth="60.0" text="Username" />
      <TextField fx:id="txtUserName" layoutX="224.0" layoutY="318.0" prefHeight="26.0" prefWidth="272.0" />
      <Text fill="#2306c9" layoutX="201.0" layoutY="102.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Login">
         <font>
            <Font name="System Bold Italic" size="64.0" />
         </font>
      </Text>
      <ImageView fitHeight="150.0" fitWidth="200.0" layoutX="231.0" layoutY="136.0" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@../img/img1.png" />
